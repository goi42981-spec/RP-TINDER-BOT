# Telegram-бот: токен от @BotFather
BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# ID чата, членство в котором проверяется (число со знаком "-" для групп/каналов)
REQUIRED_CHAT_ID=-1001234567890

# Опционально: публичная ссылка на чат, чтобы предложить юзеру вступить
REQUIRED_CHAT_LINK=https://t.me/your_rp_chat

# PostgreSQL (Neon) — для продакшена на Render.
# Если не задано — используется локальный SQLite (DB_PATH).
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Путь к SQLite (fallback, по умолчанию rp_bot.db)
# DB_PATH=rp_bot.db

# Админы бота (видят /all и могут /ban, /unban). ID через запятую.
# Если не задано — используются ID по умолчанию из config.py.
# ADMIN_IDS=6059246800,743634485
